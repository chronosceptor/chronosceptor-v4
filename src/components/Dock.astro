---
/**
 * Dock de piezas.
 *
 * Se arrastra una ficha al lienzo para colocarla. Mientras se arrastra una
 * pieza ya colocada, el dock entero se convierte en papelera: es el mismo sitio
 * de donde salio, asi que no hay una zona nueva que aprender ni un boton de
 * borrar que buscar.
 */

import { PALETTES, rgbCss, type Palette } from '../sand/palette';

/**
 * Las fichas que se arrastran al lienzo.
 *
 * La fuente sale en dos: lo que siembra cada chorro se elige al colocarlo y ya
 * no cambia. Hubo un interruptor de escena que las pasaba todas a agua o a
 * arena de golpe, y con dos fichas solo daba para contradecirse — colocabas una
 * de arena y el interruptor la volvia de agua sin tocarla.
 *
 * `id` decide el icono y `kind` la pieza: dos fichas distintas colocan la misma
 * clase con distinto material.
 */
const PIEZAS = [
  { id: 'emitter-sand', kind: 'emitter', material: 'sand', label: 'Fuente de arena' },
  { id: 'emitter-water', kind: 'emitter', material: 'water', label: 'Fuente de agua' },
  { id: 'ball', kind: 'ball', material: null, label: 'Bola: rebota y se come la arena' },
  { id: 'bomb', kind: 'bomb', material: null, label: 'Bomba' },
] as const;

/**
 * El disco de una paleta: una cuna por color, del tamano de su peso.
 *
 * Con las cuatro cunas iguales, la muestra miente — dice que la paleta es
 * cuatro colores a partes iguales cuando el ultimo apenas aparece en la arena.
 */
function disco(p: Palette): string {
  const total = p.weights.reduce((a, b) => a + b, 0);
  let acc = 0;
  const cunas = p.colors.map((c, i) => {
    const desde = (acc / total) * 360;
    acc += p.weights[i]!;
    return `${rgbCss(c)} ${desde.toFixed(2)}deg ${((acc / total) * 360).toFixed(2)}deg`;
  });
  return `conic-gradient(from -90deg, ${cunas.join(', ')})`;
}

const INICIAL = PALETTES[0]!;
---

<div id="dock" role="toolbar" aria-label="Piezas y color">
  <div id="dock-fichas">
    {
      PIEZAS.map(({ id, kind, material, label }) => (
        <>
        <button
          type="button"
          class="ficha"
          data-kind={kind}
          data-material={material}
          title={label}
          aria-label={label}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {/* Las dos fuentes se nombran por LO QUE ECHAN, no por la pieza.
                Es lo unico que las distingue —el chorro es el mismo— y ademas
                lo que se busca al mirar el dock: no "una fuente", sino arena o
                agua. Un cono de granos y un cono de gotas se parecian
                demasiado a este tamano; una duna y una gota no se confunden.

                Las dos macizas: lo que cae va relleno y lo que revienta va a
                linea (la bomba y la antorcha), y eso separa de un vistazo los
                dos grupos del dock. */}
            {id === 'emitter-sand' && (
              <path
                fill="currentColor"
                stroke="none"
                d="M1.8 18.9C5.6 18.9 7.4 7.9 11.6 7.9C15.4 7.9 17.4 14.4 19 16.6C19.8 17.7 20.9 18.9 22.2 18.9Z"
              />
            )}
            {id === 'emitter-water' && (
              <path
                fill="currentColor"
                stroke="none"
                d="M12 3.6c3.5 4.2 5.6 6.9 5.6 9.7a5.6 5.6 0 0 1-11.2 0c0-2.8 2.1-5.5 5.6-9.7z"
              />
            )}
            {/* Un circulo y nada mas. La bola es maciza y no hace mas que rodar:
                las lineas de movimiento que llevaba prometian un efecto que no
                existe, y con el circulo relleno ya no hay forma de confundirla
                con la bomba, que va hueca y con mecha. */}
            {id === 'ball' && <circle cx="12" cy="12" r="6.4" fill="currentColor" stroke="none" />}
            {id === 'bomb' && (
              <>
                <circle cx="11" cy="14.5" r="6.2" />
                <path d="M15.4 10.1l1.9-1.9M17.3 8.2c.9-1.4 2.2-1.4 3.1-.4" />
              </>
            )}
          </svg>
        </button>
        {/* La antorcha va aqui, en el hueco entre las dos fuentes y la bola, y
            no despues del grupo: los tres iconos que eligen "que echo al
            lienzo" tienen que estar juntos. Se escribe dentro del bucle para
            que el orden del DOM sea el orden que se ve — con `order` de flex
            saldria bien en pantalla y el tabulador iria por otro sitio.

            No lleva la clase `.ficha` y eso es lo que importa: `.ficha` es lo
            que atenua `#dock.lleno`, y el fuego no ocupa ninguna de las diez
            plazas. Al contrario, es otra forma de hacer sitio — igual que la
            bomba, que tambien sigue disponible con el lienzo al tope. */}
        {id === 'emitter-water' && (
          <button
            type="button"
            id="dock-fuego"
            title="Antorcha: prende tus trazos"
            aria-label="Antorcha: prende tus trazos"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {/* Llama hueca, del mismo peso de trazo que la bomba. Las dos
                  cosas que revientan van a linea y las dos que caen van
                  macizas, que es lo que separa de un vistazo los dos grupos. */}
              <path d="M12 21.2c-3.1 0-5.5-2.1-5.5-5 0-3.9 3.7-5.7 3.2-10 2.4 1.2 3.7 3.4 3.7 5.5 0 0 1.2-1 1.2-2.7 2 1.9 2.9 4.4 2.9 7.2 0 2.9-2.4 5-5.5 5z" />
            </svg>
          </button>
        )}
        </>
      ))
    }
  </div>

  {/* El separador y el boton de color van fuera de #dock-fichas: no se
      arrastran, y el tope de piezas no debe apagarlos. Dentro se habrian
      apagado con el lienzo lleno, que es justo cuando mas falta hace poder
      cambiar de color. */}
  <div id="dock-sep" aria-hidden="true"></div>

  <button
    type="button"
    id="dock-color"
    title="Color de la arena"
    aria-label="Color de la arena"
    aria-expanded="false"
    aria-controls="dock-paletas"
  >
    <span id="dock-color-disco" style={`background:${disco(INICIAL)}`}></span>
  </button>

  <div id="dock-paletas" role="group" aria-label="Paletas">
    {
      PALETTES.map((p) => (
        <button
          type="button"
          class="muestra"
          aria-pressed={p.id === INICIAL.id}
          data-palette={p.id}
          title={p.name}
          aria-label={p.name}
          style={`background:${disco(p)}`}
        />
      ))
    }
  </div>

  <div id="dock-papelera" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M7 7l10 10M17 7L7 17" />
    </svg>
    <span>soltar para quitar</span>
  </div>
</div>

<style>
  #dock {
    position: fixed;
    bottom: clamp(14px, 3.5vh, 30px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    padding: 6px;
    border-radius: 999px;
    /* Mismo filete de un pixel que la maquinaria de la escena. */
    outline: 1px solid #2a2a31;
    background: rgba(15, 15, 17, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    touch-action: none;
    opacity: 1;
    transition: opacity 900ms ease, outline-color 200ms ease;
  }

  /* Se retira sola cuando nadie toca nada, igual que la tarjeta de la cancion. */
  #dock.reposo {
    opacity: 0;
  }

  #dock-fichas {
    display: flex;
    gap: 2px;
  }

  .ficha {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #8a8a97;
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease, background-color 160ms ease, opacity 200ms ease;
  }

  .ficha svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ficha:hover,
  .ficha:focus-visible {
    color: #d6d6e0;
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  .ficha:active {
    cursor: grabbing;
  }

  /* Tope de piezas alcanzado: las fichas dejan de ofrecerse. La antorcha no
     lleva `.ficha` y por eso no entra aqui — no ocupa plaza, y con el lienzo
     lleno es justo cuando mas sirve. */
  #dock.lleno .ficha,
  #dock.solo-bomba .ficha:not([data-kind='bomb']) {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* --- La antorcha ---------------------------------------------------------
     Misma caja que una ficha, pero se pulsa en vez de arrastrarse. */
  #dock-fuego {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #8a8a97;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease, background-color 160ms ease;
  }

  #dock-fuego svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #dock-fuego:hover,
  #dock-fuego:focus-visible {
    color: #d6d6e0;
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  /* Encendida. Es el unico boton del dock que deja algo activo, asi que la
     senal tiene que ser inequivoca: el color de la llama, que no lo usa nada
     mas del dock, y el mismo aro que marca la paleta elegida. Un aro y no una
     escala, por lo mismo que alli — agrandarla movia a las vecinas. */
  #dock-fuego[aria-pressed='true'] {
    color: #ff8a3d;
    background: rgba(255, 138, 61, 0.12);
    box-shadow: 0 0 0 1px rgba(255, 138, 61, 0.55);
  }

  /* --- Color de la arena --------------------------------------------------- */

  #dock-sep {
    width: 1px;
    height: 24px;
    margin: 0 6px;
    background: #2a2a31;
  }

  #dock-color {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 160ms ease;
  }

  #dock-color:hover,
  #dock-color:focus-visible,
  #dock-color[aria-expanded='true'] {
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }


  #dock-color-disco,
  .muestra {
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 0 0 1px #2a2a31;
  }

  #dock-color-disco {
    width: 22px;
    height: 22px;
  }

  #dock-color:hover #dock-color-disco,
  #dock-color[aria-expanded='true'] #dock-color-disco {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 0 0 1px #6a6a77;
  }

  /* Encima del dock y anclado a el: #dock tiene `transform`, asi que es el
     bloque contenedor de sus hijos absolutos aunque este el mismo desplazado. */
  #dock-paletas {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    display: none;
    gap: 5px;
    padding: 7px;
    border-radius: 999px;
    outline: 1px solid #2a2a31;
    background: rgba(15, 15, 17, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  #dock.paleta #dock-paletas {
    display: flex;
  }

  .muestra {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .muestra:hover,
  .muestra:focus-visible {
    outline: none;
    transform: scale(1.12);
  }

  /* La elegida se separa por un aro, no por tamano: agrandarla movia a las
     vecinas de sitio cada vez que se cambiaba de paleta. */
  .muestra[aria-pressed='true'] {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 0 0 2px #d6d6e0;
  }

  /* --- Papelera ---------------------------------------------------------- */

  #dock-papelera {
    display: none;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px 0 14px;
    color: #b4b4c0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  #dock-papelera svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
  }

  /* Con una pieza en la mano el dock es el destino del gesto, asi que aparece
     de golpe: heredando el fundido de 900 ms del reposo, la papelera terminaba
     de dibujarse despues de que ya se hubiera soltado la pieza. */
  #dock.papelera {
    outline-color: #6a6a77;
    opacity: 1;
    transition: opacity 120ms ease;
  }

  #dock.papelera #dock-fichas,
  #dock.papelera #dock-sep,
  #dock.papelera #dock-color,
  #dock.papelera #dock-paletas {
    display: none;
  }

  #dock.papelera #dock-papelera {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    #dock,
    .ficha,
    #dock-fuego,
    #dock-color,
    .muestra {
      transition: none;
    }
  }
</style>
