---
/**
 * Dock de piezas.
 *
 * Se arrastra una ficha al lienzo para colocarla. Mientras se arrastra una
 * pieza ya colocada, el dock entero se convierte en papelera: es el mismo sitio
 * de donde salio, asi que no hay una zona nueva que aprender ni un boton de
 * borrar que buscar.
 */

import { PALETTES, rgbCss, type Palette } from '../sand/palette';

const PIEZAS = [
  { kind: 'emitter', label: 'Fuente' },
  { kind: 'ball', label: 'Bola: rebota y se come la arena' },
  { kind: 'bomb', label: 'Bomba' },
] as const;

/**
 * El disco de una paleta: una cuna por color, del tamano de su peso.
 *
 * Con las cuatro cunas iguales, la muestra miente — dice que la paleta es
 * cuatro colores a partes iguales cuando el ultimo apenas aparece en la arena.
 */
function disco(p: Palette): string {
  const total = p.weights.reduce((a, b) => a + b, 0);
  let acc = 0;
  const cunas = p.colors.map((c, i) => {
    const desde = (acc / total) * 360;
    acc += p.weights[i]!;
    return `${rgbCss(c)} ${desde.toFixed(2)}deg ${((acc / total) * 360).toFixed(2)}deg`;
  });
  return `conic-gradient(from -90deg, ${cunas.join(', ')})`;
}

const INICIAL = PALETTES[0]!;
---

<div id="dock" role="toolbar" aria-label="Piezas y color">
  <div id="dock-fichas">
    {
      PIEZAS.map(({ kind, label }) => (
        <button type="button" class="ficha" data-kind={kind} title={label} aria-label={label}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {/* El chorro, que es lo unico que se ve de la fuente: la pieza no se
                dibuja. Llevaba una tolva con cano y prometia algo que en el
                lienzo no existe. Nace en un punto y se abre hacia abajo, igual
                que la arena. */}
            {kind === 'emitter' && (
              <g fill="currentColor" stroke="none">
                <circle cx="12" cy="4.2" r="1.15" />
                <circle cx="10.1" cy="9" r="1.15" />
                <circle cx="13.9" cy="9" r="1.15" />
                <circle cx="8.2" cy="14" r="1.15" />
                <circle cx="12" cy="14" r="1.15" />
                <circle cx="15.8" cy="14" r="1.15" />
                <circle cx="6.3" cy="19" r="1.15" />
                <circle cx="10.1" cy="19" r="1.15" />
                <circle cx="13.9" cy="19" r="1.15" />
                <circle cx="17.7" cy="19" r="1.15" />
              </g>
            )}
            {/* Un circulo y nada mas. La bola es maciza y no hace mas que rodar:
                las lineas de movimiento que llevaba prometian un efecto que no
                existe, y con el circulo relleno ya no hay forma de confundirla
                con la bomba, que va hueca y con mecha. */}
            {kind === 'ball' && <circle cx="12" cy="12" r="6.4" fill="currentColor" stroke="none" />}
            {kind === 'bomb' && (
              <>
                <circle cx="11" cy="14.5" r="6.2" />
                <path d="M15.4 10.1l1.9-1.9M17.3 8.2c.9-1.4 2.2-1.4 3.1-.4" />
              </>
            )}
          </svg>
        </button>
      ))
    }
  </div>

  {/* El separador, el interruptor de material y el boton de color van fuera de
      #dock-fichas: no se arrastran, y el tope de piezas no debe apagarlos.
      Dentro se habrian apagado con el lienzo lleno, que es justo cuando mas
      falta hace poder cambiar de material o de color. */}
  <div id="dock-sep" aria-hidden="true"></div>

  {/* Que cae de las fuentes. Un solo boton con dos estados y no dos fichas: es
      un interruptor de la escena entera, no una pieza que se coloque. El icono
      que se ve es el del material que esta cayendo AHORA, no el que se
      obtendria al pulsar — un boton que ensena lo que va a pasar en vez de lo
      que pasa deja de poder leerse como indicador. */}
  <button type="button" id="dock-material" title="Cae arena" aria-label="Cae arena" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      {/* Arena: tres granos sueltos cayendo, del mismo relleno macizo que el
          chorro de la ficha de la fuente. */}
      <g class="mat-arena" fill="currentColor" stroke="none">
        <circle cx="8.4" cy="7.4" r="1.5" />
        <circle cx="14.6" cy="11" r="1.5" />
        <circle cx="9.6" cy="15.4" r="1.5" />
        <circle cx="15.2" cy="17.4" r="1.5" />
      </g>
      {/* Agua: una gota, a trazo, del grosor de las demas piezas huecas. */}
      <g class="mat-agua">
        <path d="M12 4.2c3.4 4 5.4 6.7 5.4 9.4a5.4 5.4 0 0 1-10.8 0c0-2.7 2-5.4 5.4-9.4z" />
      </g>
    </svg>
  </button>

  <button
    type="button"
    id="dock-color"
    title="Color de la arena"
    aria-label="Color de la arena"
    aria-expanded="false"
    aria-controls="dock-paletas"
  >
    <span id="dock-color-disco" style={`background:${disco(INICIAL)}`}></span>
  </button>

  <div id="dock-paletas" role="group" aria-label="Paletas">
    {
      PALETTES.map((p) => (
        <button
          type="button"
          class="muestra"
          aria-pressed={p.id === INICIAL.id}
          data-palette={p.id}
          title={p.name}
          aria-label={p.name}
          style={`background:${disco(p)}`}
        />
      ))
    }
  </div>

  <div id="dock-papelera" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M7 7l10 10M17 7L7 17" />
    </svg>
    <span>soltar para quitar</span>
  </div>
</div>

<style>
  #dock {
    position: fixed;
    bottom: clamp(14px, 3.5vh, 30px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    padding: 6px;
    border-radius: 999px;
    /* Mismo filete de un pixel que la maquinaria de la escena. */
    outline: 1px solid #2a2a31;
    background: rgba(15, 15, 17, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    touch-action: none;
    opacity: 1;
    transition: opacity 900ms ease, outline-color 200ms ease;
  }

  /* Se retira sola cuando nadie toca nada, igual que la tarjeta de la cancion. */
  #dock.reposo {
    opacity: 0;
  }

  #dock-fichas {
    display: flex;
    gap: 2px;
  }

  .ficha {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #8a8a97;
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease, background-color 160ms ease, opacity 200ms ease;
  }

  .ficha svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ficha:hover,
  .ficha:focus-visible {
    color: #d6d6e0;
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  .ficha:active {
    cursor: grabbing;
  }

  /* Tope de piezas alcanzado: las fichas dejan de ofrecerse. */
  #dock.lleno .ficha,
  #dock.solo-bomba .ficha:not([data-kind='bomb']) {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* --- Color de la arena --------------------------------------------------- */

  #dock-sep {
    width: 1px;
    height: 24px;
    margin: 0 6px;
    background: #2a2a31;
  }

  #dock-color {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 160ms ease;
  }

  #dock-color:hover,
  #dock-color:focus-visible,
  #dock-color[aria-expanded='true'] {
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  /* El disco lleva el mismo filete de un pixel que todo lo demas: sin el, sobre
     el fondo translucido del dock la muestra flota sin borde. */
  /* Mismo boton que el de color: 44x44, redondo y del gris de las fichas. */
  #dock-material {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #8a8a97;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }

  #dock-material svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #dock-material:hover,
  #dock-material:focus-visible {
    color: #d6d6e0;
    background: rgba(255, 255, 255, 0.06);
  }

  /* Solo se ve el material que esta cayendo. El estado lo lleva aria-pressed,
     asi que el CSS y el lector de pantalla dicen lo mismo sin duplicar nada. */
  #dock-material .mat-agua {
    display: none;
  }

  #dock-material[aria-pressed='true'] .mat-arena {
    display: none;
  }

  #dock-material[aria-pressed='true'] .mat-agua {
    display: inline;
  }

  #dock-color-disco,
  .muestra {
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 0 0 1px #2a2a31;
  }

  #dock-color-disco {
    width: 22px;
    height: 22px;
  }

  #dock-color:hover #dock-color-disco,
  #dock-color[aria-expanded='true'] #dock-color-disco {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 0 0 1px #6a6a77;
  }

  /* Encima del dock y anclado a el: #dock tiene `transform`, asi que es el
     bloque contenedor de sus hijos absolutos aunque este el mismo desplazado. */
  #dock-paletas {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    display: none;
    gap: 5px;
    padding: 7px;
    border-radius: 999px;
    outline: 1px solid #2a2a31;
    background: rgba(15, 15, 17, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  #dock.paleta #dock-paletas {
    display: flex;
  }

  .muestra {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .muestra:hover,
  .muestra:focus-visible {
    outline: none;
    transform: scale(1.12);
  }

  /* La elegida se separa por un aro, no por tamano: agrandarla movia a las
     vecinas de sitio cada vez que se cambiaba de paleta. */
  .muestra[aria-pressed='true'] {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 0 0 2px #d6d6e0;
  }

  /* --- Papelera ---------------------------------------------------------- */

  #dock-papelera {
    display: none;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px 0 14px;
    color: #b4b4c0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  #dock-papelera svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
  }

  /* Con una pieza en la mano el dock es el destino del gesto, asi que aparece
     de golpe: heredando el fundido de 900 ms del reposo, la papelera terminaba
     de dibujarse despues de que ya se hubiera soltado la pieza. */
  #dock.papelera {
    outline-color: #6a6a77;
    opacity: 1;
    transition: opacity 120ms ease;
  }

  #dock.papelera #dock-fichas,
  #dock.papelera #dock-material,
  #dock.papelera #dock-sep,
  #dock.papelera #dock-color,
  #dock.papelera #dock-paletas {
    display: none;
  }

  #dock.papelera #dock-papelera {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    #dock,
    .ficha,
    #dock-color,
    .muestra {
      transition: none;
    }
  }
</style>
