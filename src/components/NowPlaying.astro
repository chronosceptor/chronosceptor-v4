---
/**
 * Tarjeta de "sonando ahora".
 *
 * Sin caja ni desenfoque: una regla vertical fina la ancla al margen y la
 * separacion la hace el aire, no un recuadro. El margen es el mismo 5% del
 * ancho al que estan los muros de la escena, para que el texto caiga sobre la
 * misma linea que la estructura.
 */
---

<a id="sonando" hidden target="_blank" rel="noopener noreferrer">
  <img id="sonando-portada" alt="" width="46" height="46" />
  <span id="sonando-texto">
    <span id="sonando-titulo"></span>
    <span id="sonando-meta">
      <span id="sonando-artista"></span>
      <span id="sonando-cuando"></span>
    </span>
    <span id="sonando-paleta" aria-hidden="true"></span>
  </span>
</a>

<style>
  #sonando {
    position: fixed;
    top: clamp(18px, 4.5vh, 40px);
    left: clamp(18px, 5vw, 72px);
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    max-width: min(320px, calc(100vw - 40px));
    color: #b4b4c0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
    opacity: 1;
    transition: opacity 900ms ease;
  }

  /* Se retira sola cuando nadie toca nada, y vuelve al primer movimiento. */
  #sonando.reposo {
    opacity: 0;
  }

  #sonando[hidden] {
    display: none !important;
  }

  #sonando-portada {
    width: 46px;
    height: 46px;
    object-fit: cover;
    background: #17171a;
    flex: none;
    /* Filete de un pixel, del mismo peso que la maquinaria. */
    outline: 1px solid #393942;
    outline-offset: 0;
  }

  #sonando-texto {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    padding-top: 1px;
  }

  #sonando-titulo {
    color: #ececf2;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 450;
    letter-spacing: 0.005em;
  }

  /* Versalitas espaciadas: el artista es dato secundario y se lee como etiqueta. */
  #sonando-artista {
    color: #75757f;
    font-size: 10px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* Artista y antiguedad comparten renglon: el dato de cuando se escucho es
     secundario y no merece una linea propia. */
  #sonando-meta {
    display: flex;
    align-items: baseline;
    min-width: 0;
  }

  /* La tarjeta no debe dar por "sonando" algo que quiza ya termino, pero
     decirlo tiene que costar lo minimo posible en peso visual. */
  #sonando-cuando {
    flex: none;
    color: #4a4a53;
    font-size: 9px;
    /* Mismo tratamiento que el artista: comparten renglon y con uno en
       versalitas y el otro en caja baja se leen como dos cosas distintas. */
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* Sonando ahora mismo: es el estado que mas dice, y merece destacar algo
     sobre el "hace un rato" sin llegar a competir con el titulo. */
  #sonando-cuando.vivo {
    color: #8f8f9b;
  }

  #sonando-cuando:not(:empty)::before {
    content: '·';
    margin: 0 6px;
  }

  #sonando-titulo,
  #sonando-artista {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Las muestras dicen de donde salieron los colores que estan cayendo. */
  #sonando-paleta {
    display: flex;
    gap: 4px;
    margin-top: 3px;
  }

  #sonando-paleta i {
    display: block;
    width: 14px;
    height: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    #sonando {
      transition: none;
    }
  }
</style>
