---
/** Isla de canvas. Solo el marcado: el arranque vive en la pagina. */
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

/* La lista de fondos se lee de public/ al compilar: anadir uno es soltar el
   archivo ahi con ese nombre, sin tocar codigo. Si no hay ninguno queda el
   color plano de debajo.
   Va contra process.cwd() y no contra import.meta.url a proposito: en el build
   este frontmatter corre ya empaquetado dentro de .netlify/build, asi que la
   ruta relativa al modulo apunta a un sitio que no existe. Da por hecho que
   astro se lanza desde la raiz del proyecto, que es como se lanza. */
const fondos = readdirSync(join(process.cwd(), 'public'))
  .filter((f) => /^background\d+\.webp$/.test(f))
  .sort()
  .map((f) => `/${f}`);
---

<!-- Se elige aqui, en linea y antes de que exista #escena, para que el fondo
     entre ya con el primer pintado y no haya parpadeo de negro a foto. -->
<script is:inline define:vars={{ fondos }}>
  if (fondos.length) {
    const fondo = fondos[Math.floor(Math.random() * fondos.length)];
    document.documentElement.style.setProperty('--fondo', `url('${fondo}')`);
  }
</script>

<div id="escena">
  <canvas id="arena"></canvas>
  <canvas id="fx"></canvas>
</div>

<style>
  #escena {
    position: fixed;
    inset: 0;
    /* Velo y rayas van en la pila de fondo, o sea POR DEBAJO de los canvas: la
       foto queda apagada y con textura de pantalla, y la arena no se toca. Ese
       es el punto — el color de la arena viene de la portada y cualquier capa
       por encima lo apaga: unas rayas sobre el canvas volvian el amarillo un
       verde sucio. Aqui la arena es lo unico nitido y saturado del cuadro. */
    background:
      repeating-linear-gradient(rgba(0, 0, 0, .2) 0 1px, transparent 1px 3px),
      linear-gradient(rgba(11, 11, 12, 0.45), rgba(11, 11, 12, 0.45)),
      var(--fondo, none) center / cover no-repeat,
      #0b0b0c;
    overflow: hidden;
  }

  #escena canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* La capa de arena es un canvas pequeno que el navegador amplia sin suavizar:
     asi el grano queda nitido y no se paga un drawImage por frame. */
  #arena {
    image-rendering: pixelated;
  }

  /* La capa vectorial va encima y es la que recibe el puntero. */
  #fx {
    touch-action: none;
    cursor: crosshair;
  }
</style>
