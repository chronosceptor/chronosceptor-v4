---
import SandCanvas from '../components/SandCanvas.astro';
import Dock from '../components/Dock.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>chronosceptor</title>
    <meta
      name="description"
      content="Draw to divert the sand. The colours come from whatever I am listening to."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Vista previa al compartir el enlace. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chronosceptor.com/" />
    <meta property="og:title" content="Sandbox" />
    <meta
      property="og:description"
      content="Draw to divert the sand. The colours come from whatever I am listening to."
    />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <SandCanvas />
    <Dock />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background: #0b0b0c;
    -webkit-tap-highlight-color: transparent;
    overscroll-behavior: none;
  }
</style>


<script>
  import { boot } from '../sand';
  import { mountDock } from '../sand/dock';
  import { watchNowPlaying } from '../lib/nowPlaying';
  import { paletteFromImage } from '../sand/color/extract';
  import { DEFAULT_PALETTE } from '../sand/palette';

  const params = new URLSearchParams(location.search);
  /** `?mock` sirve un track fijo: permite afinar el color sin API key. */
  const mock = params.has('mock');

  const app = boot({
    sandCanvas: document.getElementById('arena') as HTMLCanvasElement,
    fxCanvas: document.getElementById('fx') as HTMLCanvasElement,
    debug: params.has('debug'),
    // `?fill=0.2` dispara el drenaje mucho antes: sirve para probar la descarga
    // sin esperar el ciclo completo.
    fillFrac: params.has('fill') ? Number(params.get('fill')) : undefined,
  });

  // Para trastear desde la consola: `fabrica.clear()` vacia el lienzo.
  (window as any).fabrica = app;

  // Se desvanece tras un rato sin actividad y vuelve al primer movimiento.
  const dock = document.getElementById('dock') as HTMLElement;
  let idleTimer = 0;
  function wake(): void {
    dock.classList.remove('reposo');
    clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => {
      // Con una pieza en la mano el dock es la papelera: desvanecerlo justo
      // entonces dejaria el gesto sin destino a la vista.
      if (!dock.classList.contains('papelera')) dock.classList.add('reposo');
    }, 7000);
  }
  for (const evt of ['pointermove', 'pointerdown', 'keydown'] as const) {
    window.addEventListener(evt, wake, { passive: true });
  }

  mountDock(app, dock, wake);
  wake();

  // --- Enlace entre la musica y la arena -----------------------------------
  //
  // La cancion no se muestra en ninguna parte: lo unico que sale de ella es el
  // color. Se sigue sondeando porque hace falta saber que suena para pedir su
  // portada, pero el titulo y el artista no llegan a pintarse.

  watchNowPlaying(
    async (track) => {
      if (!track) {
        // Sin musica sonando se vuelve a la paleta ocre; el regreso del color
        // al dar play es lo que hace visible que la pagina esta escuchando.
        app.setPalette(DEFAULT_PALETTE);
        return;
      }

      let palette = DEFAULT_PALETTE;
      if (track.art) {
        const extracted = await paletteFromImage(track.art, `${track.artist}|${track.title}`);
        if (extracted) palette = extracted;
      }
      app.setPalette(palette);
    },
    20000,
    mock ? '/api/now-playing?mock=1' : '/api/now-playing',
  );
</script>
