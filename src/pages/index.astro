---
import SandCanvas from '../components/SandCanvas.astro';
import NowPlaying from '../components/NowPlaying.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>chronosceptor</title>
    <meta
      name="description"
      content="Draw to divert the sand. The colours come from whatever I am listening to."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Vista previa al compartir el enlace. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chronosceptor.com/" />
    <meta property="og:title" content="Sandbox" />
    <meta
      property="og:description"
      content="Draw to divert the sand. The colours come from whatever I am listening to."
    />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <SandCanvas />
    <NowPlaying />

  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background: #0b0b0c;
    -webkit-tap-highlight-color: transparent;
    overscroll-behavior: none;
  }
</style>


<script>
  import { boot } from '../sand';
  import { watchNowPlaying, type Track } from '../lib/nowPlaying';
  import { paletteFromImage } from '../sand/color/extract';
  import { DEFAULT_PALETTE, rgbCss, type Palette } from '../sand/palette';

  const params = new URLSearchParams(location.search);
  /** `?mock` sirve un track fijo: permite afinar el color sin API key. */
  const mock = params.has('mock');

  const app = boot({
    sandCanvas: document.getElementById('arena') as HTMLCanvasElement,
    fxCanvas: document.getElementById('fx') as HTMLCanvasElement,
    debug: params.has('debug'),
    // `?fill=0.2` dispara el drenaje mucho antes: sirve para probar la descarga
    // sin esperar el ciclo completo.
    fillFrac: params.has('fill') ? Number(params.get('fill')) : undefined,
  });

  // Para trastear desde la consola: `fabrica.clear()` vacia el lienzo.
  (window as any).fabrica = app;

  // --- Tarjeta de "sonando ahora" ------------------------------------------

  const card = document.getElementById('sonando') as HTMLAnchorElement;
  const art = document.getElementById('sonando-portada') as HTMLImageElement;
  const title = document.getElementById('sonando-titulo') as HTMLElement;
  const artist = document.getElementById('sonando-artista') as HTMLElement;
  const when = document.getElementById('sonando-cuando') as HTMLElement;
  const swatches = document.getElementById('sonando-paleta') as HTMLElement;

  /**
   * Contexto temporal: si suena ahora, o cuanto hace que se escucho.
   *
   * El caso en vivo es el que mas dice y antes no se etiquetaba: quedaba vacio,
   * indistinguible de una cancion de hace rato.
   */
  function agoLabel(track: Track): string {
    if (track.playing) return 'now playing';
    if (!track.playedAt) return '';
    const min = Math.max(0, (Date.now() / 1000 - track.playedAt) / 60);
    if (min < 1) return 'just now';
    if (min < 60) return `${Math.round(min)} min ago`;
    return `${Math.round(min / 60)} h ago`;
  }

  /** Cancion en pantalla, para poder refrescar su antiguedad. */
  let current: Track | null = null;

  /**
   * La antiguedad se recalcula sola cada medio minuto.
   *
   * El sondeo solo avisa cuando cambia la cancion, asi que sin esto la etiqueta
   * se congela en el valor que tuviera al aparecer: diria "just now" una hora
   * despues.
   */
  window.setInterval(() => {
    if (current) when.textContent = agoLabel(current);
  }, 30000);

  function showCard(track: Track, palette: Palette): void {
    current = track;
    title.textContent = track.title ?? '';
    artist.textContent = track.artist ?? '';
    when.textContent = agoLabel(track);
    when.classList.toggle('vivo', track.playing);
    if (track.art) {
      art.src = track.art;
      art.hidden = false;
    } else {
      art.removeAttribute('src');
      art.hidden = true;
    }
    if (track.url) card.href = track.url;
    else card.removeAttribute('href');

    swatches.replaceChildren(
      ...palette.colors.slice(0, 5).map((c) => {
        const i = document.createElement('i');
        i.style.background = rgbCss(c);
        return i;
      }),
    );
    card.hidden = false;
    wake();
  }

  // Se desvanece tras un rato sin actividad y vuelve al primer movimiento.
  let idleTimer = 0;
  function wake(): void {
    card.classList.remove('reposo');
    clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => card.classList.add('reposo'), 7000);
  }
  for (const evt of ['pointermove', 'pointerdown', 'keydown'] as const) {
    window.addEventListener(evt, wake, { passive: true });
  }

  // --- Enlace entre la musica y la arena -----------------------------------

  watchNowPlaying(
    async (track) => {
      if (!track) {
        // Sin musica sonando se vuelve a la paleta ocre; el regreso del color
        // al dar play es lo que hace visible que la pagina esta escuchando.
        app.setPalette(DEFAULT_PALETTE);
        current = null;
        card.hidden = true;
        return;
      }

      let palette = DEFAULT_PALETTE;
      if (track.art) {
        const extracted = await paletteFromImage(track.art, `${track.artist}|${track.title}`);
        if (extracted) palette = extracted;
      }
      app.setPalette(palette);
      showCard(track, palette);
    },
    20000,
    mock ? '/api/now-playing?mock=1' : '/api/now-playing',
  );
</script>
